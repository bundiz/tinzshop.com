{
  "name": "tinzshop",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": "^20.19 || ^22.12 || >=24.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "shopee:token": "node --env-file=.env scripts/shopee-sandbox/get-token.mjs",
    "shopee:seed": "node --env-file=.env scripts/shopee-sandbox/seed.mjs",
    "shopee:dump": "node --env-file=.env scripts/shopee-sandbox/dump.mjs",
    "db:up": "docker compose up -d postgres",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "next": "16.4.3",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prisma": "7.10.1",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
