{
  "name": "tinzshop",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": "^20.19 || ^22.12 || >=24.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "shopee:token": "node --env-file=.env scripts/shopee-sandbox/get-token.mjs",
    "shopee:seed": "node --env-file=.env scripts/shopee-sandbox/seed.mjs",
    "shopee:dump": "node --env-file=.env scripts/shopee-sandbox/dump.mjs",
    "db:up": "docker compose up -d postgres",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "job:shopee-sync": "node --env-file=.env scripts/run-job.mjs shopee-sync",
    "job:activate": "node --env-file=.env scripts/run-job.mjs catalogue-activate",
    "job:categorise": "node --env-file=.env scripts/run-job.mjs catalogue-categorise",
    "job:news-import": "node --env-file=.env scripts/run-job.mjs news-import",
    "job:news-import:full": "node --env-file=.env scripts/run-job.mjs news-import --full",
    "data:load": "npm run job:shopee-sync && npm run job:activate && npm run job:categorise && npm run job:news-import"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@tailwindcss/postcss": "4.3.3",
    "next": "16.4.3",
    "next-intl": "4.14.9",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanitize-html": "2.18.1",
    "tailwindcss": "4.3.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.2",
    "jsdom": "26.1.0",
    "prisma": "7.10.1",
    "swagger-ui-dist": "5.33.2",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
