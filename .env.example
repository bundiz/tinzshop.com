# Tinzshop — example environment file
#
# PLACEHOLDERS ONLY. Never put real values in this file; it is committed to git.
# Copy to `.env` (git-ignored) and fill locally.
#

# --- Application ---
APP_ENV=development
APP_URL=http://localhost:3003

# --- Database ---
# Local PostgreSQL from compose.yaml (loopback only, trust auth, no password).
DATABASE_URL=postgresql://postgres@127.0.0.1:5434/tinzshop
# Database used by `npm run test:integration`; its name must end in _test.
TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:5434/tinzshop_test

# --- K-Payment (Kasikorn Bank) — NOT RESEARCHED ---
# Merchant account and test data not yet supplied by the client. See Q-033.
KPAYMENT_MERCHANT_ID=
KPAYMENT_API_KEY=
KPAYMENT_WEBHOOK_SECRET=

# --- Shopee (catalogue mirror, plan 010) ---
# Sandbox Test Partner and sandbox shop held; live partner key and shop authorization not yet supplied. See Q-042.
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
# The shop id shown after authorizing the app; the callback accepts only this shop.
SHOPEE_SHOP_ID=
# Shopee Open Platform base URL (https only); defaults to the sandbox host when empty.
SHOPEE_API_BASE_URL=

# --- Background jobs ---
# Shared secret that authorises job endpoints (at least 32 characters). Generate: openssl rand -base64 32
JOB_SECRET=

# --- News import (plan 012) ---
# Origin of the old tinzshop.com WordPress site the news import reads (http or https). Not a secret.
NEWS_IMPORT_SOURCE_URL=

# --- Channel tokens ---
# 32-byte AES key, base64 encoded, used to encrypt stored channel tokens. Generate: openssl rand -base64 32
CHANNEL_TOKEN_ENCRYPTION_KEY=

# --- Customer authentication: Amazon Cognito (plan 014) ---
# Region of the user pool. Left blank on purpose: the dev pool is in ap-southeast-7 (Thailand);
# ap-southeast-1 (Singapore) is the fallback if a pool cannot be made there. Ask a teammate which one.
COGNITO_REGION=
# The customer user pool id, for example ap-southeast-7_XXXXXXXXX.
COGNITO_USER_POOL_ID=
# The app client id of the customer pool's confidential client.
COGNITO_CLIENT_ID=
# The app client's secret. Never commit a real one.
COGNITO_CLIENT_SECRET=
# The Cognito domain's full host name WITHOUT a scheme, for example your-prefix.auth.ap-southeast-1.amazoncognito.com
COGNITO_DOMAIN=
# 32-byte AES key, base64 encoded, that seals session tokens and the sign-in cookies. Generate: openssl rand -base64 32
SESSION_TOKEN_ENCRYPTION_KEY=
# Optional. Which header carries the client address behind a proxy: x-forwarded-for (default, right-most entry) or cf-connecting-ip.
TRUSTED_PROXY_HEADER=

# --- Media storage: Amazon S3 in ap-southeast-7 (plan 017; D-274 to D-277) ---
# Your .env must use exactly these names. Set-up: docs/10-deployment.md#file-storage.
# The environment's own bucket (DEV and PROD never share one). Not a secret, but keep the real name out of git.
MEDIA_S3_BUCKET=
# The bucket's region: ap-southeast-7 (Asia Pacific (Thailand)).
MEDIA_S3_REGION=
# Public address that image keys are appended to: https only, no query, fragment, user or password (one trailing / is
# removed). Empty turns image uploads off; when it is set, MEDIA_S3_BUCKET and MEDIA_S3_REGION must be valid too.
# A malformed value is treated as empty on pages and refuses uploads, with one log line naming it (D-282).
# For a bucket: https://<bucket>.s3.ap-southeast-7.amazonaws.com ; a CloudFront address if one is added later.
MEDIA_PUBLIC_BASE_URL=
# Local machine only: the access key of the DEV IAM user (tinzshop-dev), read by the AWS SDK itself, not by the
# config module. Leave both empty on AWS hosting, where an IAM role supplies credentials (D-275). Never commit a real key.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- BigSeller — NOT RESEARCHED ---
# Paid API vs daily file export is undecided. See Q-043.
BIGSELLER_API_KEY=

# --- Shipping carrier — NOT SELECTED ---
# First carrier not chosen (Flash / Kerry / Thailand Post). See Q-034.
SHIPPING_CARRIER_API_KEY=

# --- Transactional email — PROVIDER NOT CHOSEN ---
# See Q-032.
MAIL_FROM_ADDRESS=
MAIL_API_KEY=

# --- Cloudflare — SCOPE NOT DEFINED ---
# See Q-054.
CLOUDFLARE_API_TOKEN=
