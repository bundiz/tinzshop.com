# Tinzshop — example environment file
#
# PLACEHOLDERS ONLY. Never put real values in this file; it is committed to git.
# Copy to `.env` (git-ignored) and fill locally.
#

# --- Application ---
APP_ENV=development
APP_URL=http://localhost:3000

# --- Database ---
# Local PostgreSQL from compose.yaml (loopback only, trust auth, no password).
DATABASE_URL=postgresql://postgres@127.0.0.1:5434/tinzshop
# Database used by `npm run test:integration`; its name must end in _test.
TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:5434/tinzshop_test

# --- K-Payment (Kasikorn Bank) — NOT RESEARCHED ---
# Merchant account and test data not yet supplied by the client. See Q-033.
KPAYMENT_MERCHANT_ID=
KPAYMENT_API_KEY=
KPAYMENT_WEBHOOK_SECRET=

# --- Shopee (catalogue mirror, plan 010) ---
# Sandbox Test Partner and sandbox shop held; live partner key and shop authorization not yet supplied. See Q-042.
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
# The shop id shown after authorizing the app; the callback accepts only this shop.
SHOPEE_SHOP_ID=
# Shopee Open Platform base URL (https only); defaults to the sandbox host when empty.
SHOPEE_API_BASE_URL=

# --- Background jobs ---
# Shared secret that authorises job endpoints (at least 32 characters). Generate: openssl rand -base64 32
JOB_SECRET=

# --- Channel tokens ---
# 32-byte AES key, base64 encoded, used to encrypt stored channel tokens. Generate: openssl rand -base64 32
CHANNEL_TOKEN_ENCRYPTION_KEY=

# --- BigSeller — NOT RESEARCHED ---
# Paid API vs daily file export is undecided. See Q-043.
BIGSELLER_API_KEY=

# --- Shipping carrier — NOT SELECTED ---
# First carrier not chosen (Flash / Kerry / Thailand Post). See Q-034.
SHIPPING_CARRIER_API_KEY=

# --- Transactional email — PROVIDER NOT CHOSEN ---
# See Q-032.
MAIL_FROM_ADDRESS=
MAIL_API_KEY=

# --- Cloudflare — SCOPE NOT DEFINED ---
# See Q-054.
CLOUDFLARE_API_TOKEN=
