# Tinzshop — example environment file
#
# PLACEHOLDERS ONLY. Never put real values in this file; it is committed to git.
# Copy to `.env` (git-ignored) and fill locally.
#
# IMPORTANT — read before using:
# The technology stack is NOT chosen yet, and no integration below has been
# researched or agreed. The variable names here are provisional placeholders
# derived only from the external systems NAMED in
# docs/reference/client-summary-th.md. They are not an API contract and will
# change once each integration is researched and a stack is decided.
# See docs/integrations/README.md for the status of each system.

# --- Application ---
APP_ENV=development
APP_URL=http://localhost:3000

# --- Database ---
# Engine undecided. See docs/decisions/ADR-0001-backend-approach.md
DATABASE_URL=

# --- K-Payment (Kasikorn Bank) — NOT RESEARCHED ---
# Merchant account and test data not yet supplied by the client. See Q-033.
KPAYMENT_MERCHANT_ID=
KPAYMENT_API_KEY=
KPAYMENT_WEBHOOK_SECRET=

# --- Shopee — NOT RESEARCHED ---
# Partner account and test shop not yet supplied by the client. See Q-042.
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_SHOP_ID=

# --- BigSeller — NOT RESEARCHED ---
# Paid API vs daily file export is undecided. See Q-043.
BIGSELLER_API_KEY=

# --- Shipping carrier — NOT SELECTED ---
# First carrier not chosen (Flash / Kerry / Thailand Post). See Q-034.
SHIPPING_CARRIER_API_KEY=

# --- Transactional email — PROVIDER NOT CHOSEN ---
# See Q-032.
MAIL_FROM_ADDRESS=
MAIL_API_KEY=

# --- Cloudflare — SCOPE NOT DEFINED ---
# See Q-054.
CLOUDFLARE_API_TOKEN=
